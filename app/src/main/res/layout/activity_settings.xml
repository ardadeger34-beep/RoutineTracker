Ad<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="16dp"
    android:paddingTop="48dp">

        <ImageButton
            android:id="@+id/btnSettingsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/arrow_back"
            android:background="@drawable/circle_button"
            android:layout_margin="16dp"/>
        <!-- back button -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:background="@drawable/reminder_card_background">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notifications On/Off"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"/>
            <!-- text for notification -->

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <!-- switch for notifications. -->

        </LinearLayout>
        <!-- Notification on and off bloke. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:background="@drawable/reminder_card_background">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vibration On/Off"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />
            <!-- text for vibration -->

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchVibration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <!-- switch for vibration. -->

        </LinearLayout>
        <!-- Vibration on and off bloke. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:background="@drawable/reminder_card_background">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notification Sound"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />
                <!-- text for notification sound -->

            <ImageButton
                android:id="@+id/btnSelectSound"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/dot_background"
                android:background="@drawable/circle_button"/>
                <!-- button for notification sound. -->

        </LinearLayout>
        <!-- Notification sound bloke. -->

        <View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:layout_gravity="end"
            android:layout_margin="16dp" />

</LinearLayout>
<!-- root layout. -->